[Unit]
Description=hello daemon
# the platform.s crash-policy: crash-looping daemon => reboot the box.
StartLimitIntervalSec=120
StartLimitBurst=6
StartLimitAction=reboot

[Service]
User=hello
Group=hello
# No manual mkdir anywhere: systemd owns the writable dir (boring stuff §2).
StateDirectory=hello
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
